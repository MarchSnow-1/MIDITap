<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 与 MIDITap.Core 保持一致：引用方不能比被引用方更宽

         Kept identical to MIDITap.Core
         A referencing project must not target a wider platform than the project it references -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 语言版本显式钉在 14，不用 latest：latest 会随机器上最高的 SDK 浮动，
         同一份源码在不同机器上可能编译出不同结果

         The language version is pinned to 14 rather than latest: latest floats with the highest
         SDK on the machine, so the same source may compile to different results on different machines -->
    <LangVersion>14</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MIDITap.Core\MIDITap.Core.csproj" />
  </ItemGroup>

</Project>