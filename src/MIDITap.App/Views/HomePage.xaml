<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MIDITap.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MIDITap.App.Controls"
    xmlns:local="using:MIDITap.App.Views"
    NavigationCacheMode="Disabled">

    <!-- Home -->
    <Grid Padding="24,18,24,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <!-- 音符盘与下半部分按 **3:2** 分配剩余高度
                 即盘面约占 60%、配置与日志区约占 40%
                 必须用比例而不是 Auto 行
                 Auto 行的高度由控件自己按宽度算出，窗口一变高它就跟着长
                 结果把下面的配置与日志区挤没
                 比例分配让两者随窗口一同伸缩，任何高度下都各得其所
                 比例行**不设 MinHeight**
                 设了就会在窗口变矮时由它顶住，把另一行压小甚至顶出窗口
                 纯比例分配则任何窗口高度下都是 60:40，这正是"布局要动态"的实际含义
                 唯一保留的 Auto 行是设备条：它内容固定，不参与比例分配
                 The board and the lower half split the leftover height **3:2**
                 The board takes about 60% and the config/log area about 40%
                 This must be a ratio rather than an Auto row
                 An Auto row's height is computed by the control from its own width
                 It therefore grew as the window grew taller
                 It squeezed the config and log areas out
                 A ratio lets both scale with the window so each gets its share at any height
                 The proportional rows deliberately carry **no MinHeight**
                 A minimum would hold its row up as the window shrinks, squeezing the other row or pushing it out of the window
                 A pure ratio keeps 60:40 at any window height, which is what "the layout must be dynamic" means in practice
                 The only Auto row left is the device bar, whose content is fixed and which takes no part in the split -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- ===== 设备条：图标 + 下拉 + 状态，一行搞定 / Device bar: icon + drop-down + status in one row ===== -->
        <Border Grid.Row="0" CornerRadius="8" Padding="14,10"
                Background="{ThemeResource MiditapSurfaceBrush}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE88E;" FontSize="16"
                          Foreground="{ThemeResource MiditapTextSecondaryBrush}"
                          VerticalAlignment="Center" />
                <ComboBox x:Name="DeviceBox" Grid.Column="1" HorizontalAlignment="Stretch"
                          DisplayMemberPath="Name" SelectionChanged="OnDeviceSelected"
                          Background="Transparent" BorderThickness="0" />
                <TextBlock x:Name="DeviceStateText" Grid.Column="2" Style="{ThemeResource MiditapCaptionStyle}"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- ===== 音符盘：上半部分的主角 / Note board: the star of the upper half ===== -->
        <!-- 高度不写死：控件自己按可用宽度算出高度（12 列格子 + 9 行八度 + 间距 + 内边距）
             The height is not hard-coded
             The control computes it from the available width
             That is 12 columns of cells + 9 octave rows + gaps + padding -->
        <controls:NoteGrid x:Name="NoteBoard" Grid.Row="1"
                           HorizontalAlignment="Stretch" />

        <!-- ===== 下半部分：左（配置 / 实时琴键）| 分界线 | 右（活动日志）/ Lower half: left (config / live keys) | divider | right (activity log) ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- ========== 左下 / Lower left ========== -->
            <Grid Grid.Column="0" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 左下-上：当前配置 / Lower left, top: the current config -->
                <StackPanel Grid.Row="0" Spacing="8">
                    <TextBlock x:Name="ConfigLabel" Style="{ThemeResource MiditapSubtitleStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="ConfigNameText" FontSize="15"
                                   Foreground="{ThemeResource MiditapTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ConfigCountText" Style="{ThemeResource MiditapCaptionStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- 水平分界线：配置区与实时琴键区之间 / Horizontal divider between the config area and the live-keys area -->
                <Border Grid.Row="1" Height="1" Margin="0,12"
                        Background="{ThemeResource MiditapSubtleBorderBrush}" />

                <!-- 左下-下：当前弹奏的琴键 / Lower left, bottom: the keys currently being played
                     这里**必须用 Grid 而不是垂直 StackPanel**
                     垂直 StackPanel 会给子项无限高度
                     它内部的 ScrollViewer 于是测量出"内容全装得下"，超出部分只会被裁掉而不会滚动
                     Grid 的 Auto/* 行给出确定高度，ScrollViewer 才真正生效
                     A Grid is **required here rather than a vertical StackPanel**
                     A vertical StackPanel gives its children unbounded height
                     So the ScrollViewer inside it measures that everything fits and the overflow is clipped instead of scrolling
                     The Auto/* rows of a Grid give a definite height, which is what makes the ScrollViewer take effect
                     -->
                <Grid Grid.Row="2" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="NotesLabel" Grid.Row="0"
                               Style="{ThemeResource MiditapSubtitleStyle}" />

                    <!-- chip 数量随"当前按住的音符"增长，没有天然上限
                         延音踏板、序列器都可能送出很多
                         因此放进 ScrollViewer：超出可用高度时内部滚动，而不是把版面顶开
                         The chip count tracks currently held notes and has no natural bound
                         A sustain pedal or a sequencer can send many
                         So it scrolls internally when it overflows, rather than pushing the layout open -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Stretch">
                        <!-- AutomationProperties.Name 由代码同步为当前触发的键位汇总
                             两个作用：
                               1) 无障碍 —— chip 是纯视觉呈现，屏幕阅读器原本完全读不到"刚才触发了什么"，对读屏用户这块信息是缺失的
                               2) 让 UI Automation 能观察到该区域
                                  ItemsControl 默认不暴露 AutomationPeer
                                  不给它一个名称的话，整块在 UIA 树里不可见
                             AutomationProperties.Name is kept in sync with the active key labels by code
                             It has two purposes
                               1) Accessibility — the chips are purely visual
                                  A screen reader could not report what was just triggered
                                  That information is missing for screen-reader users
                               2) It lets UI Automation observe the region
                                  An ItemsControl exposes no AutomationPeer by default
                                  Without a name the whole block stays invisible in the UIA tree -->
                        <ItemsControl x:Name="ActiveNotesItems" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Top"
                                      AutomationProperties.Name="">
                            <!-- 必须用会换行的面板
                                 横向 StackPanel **永不换行**：同时按下的音符一多，chip 就一直往右排
                                 这样把整页顶宽、右侧内容被裁掉
                                 WrapPanel 支持变宽子项，放不下即换行
                                 A WRAPPING panel is required
                                 A horizontal StackPanel never wraps, so chips marched right and pushed content out of view
                                 WrapPanel handles variable-width children and wraps when needed -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ActiveNoteChip">
                                    <!-- chip：用底色而非边框表达"正在进行"
                                         配色走主题字典，高对比度下自动换成系统色

                                         Chip: a filled background rather than a border expresses "active"
                                         The colours come from the theme dictionary, so contrast themes swap in system colours automatically -->
                                    <Border CornerRadius="6" Padding="10,5"
                                            Background="{ThemeResource MiditapChipBackgroundBrush}">
                                        <TextBlock FontFamily="Consolas" FontSize="13"
                                                   Foreground="{ThemeResource MiditapChipForegroundBrush}"
                                                   Text="{x:Bind Text}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空态与 chip 区**同格重叠**
                         这样提示就出现在 chip 本该出现的位置
                         而不是被挤到整个下半部分的底部
                         The empty state shares the chip row
                         So the hint appears where chips would, instead of being pushed to the bottom of the whole lower half -->
                    <TextBlock x:Name="ActiveNotesEmpty" Grid.Row="1"
                               Style="{ThemeResource MiditapCaptionStyle}"
                               VerticalAlignment="Top" HorizontalAlignment="Left" />
                </Grid>
            </Grid>

            <!-- 垂直分界线：左右两栏之间 / Vertical divider between the two columns -->
            <Border Grid.Column="1" Width="1" Margin="20,0"
                    Background="{ThemeResource MiditapSubtleBorderBrush}" />

            <!-- ========== 右下：活动日志 / Lower right: activity log ========== -->
            <Grid Grid.Column="2" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="LogLabel" Grid.Row="0" Style="{ThemeResource MiditapSubtitleStyle}" />
                <ScrollViewer x:Name="RecentLogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <!-- 与日志页**同一套渲染**（LogTextRenderer）
                         时间按级别着色、消息可换行，整块文本可拖动选中
                         两处显示的是同一份日志，观感与可选中范围必须一致
                         TextBlock 的内容本身就是 UIA 文本，不必再显式给名字

                         Rendered by the same LogTextRenderer as the log page
                         The timestamp is coloured by level, the message wraps, and the whole block is drag-selectable
                         The two show the same log, so their look and selectable range must match
                         A TextBlock's content is itself the UIA text, so no explicit name is needed -->
                    <TextBlock x:Name="RecentLogText" IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
