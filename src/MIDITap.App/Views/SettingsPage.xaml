<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MIDITap.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MIDITap.App.Controls">

    <!-- 设置 = 全应用唯一的偏好页（语言已并入，不再有单独的语言页）

         版式照 WinUI Gallery 的原生设置页：**页标题 + 一行一行的设置卡片**
         每张卡片左侧是图标与「标题/说明」，右侧是控件（见 Controls/SettingsCard）
         为什么用这个版式：标题在左、控件在右是 Windows 设置类界面的通行读法
         用户不必先读一遍才知道右边那个开关管什么
         说明跟在标题下面，需要时才读，不需要时它只是淡淡的第二行

         内容**铺满可用宽度**，和本项目其它页面（日志页、映射页）一样：只靠这一层的 Padding 留边
         不设限宽、不做居中
         宽度完全由窗口决定，因此拖窗口时卡片跟着变，没有任何写死的尺寸
         卡内控件也不写宽度（代理输入框除外：地址比按钮长得多，见那里的说明）

         Settings is the application's only preferences page
         Language is merged into it, and there is no separate language page

         The layout follows the native settings page in WinUI Gallery
         That is **a page title plus one settings card per row**
         Each card carries an icon and a "title / description" on the left, and the control on the right (see Controls/SettingsCard)
         Why this layout: a title on the left and the control on the right is the accepted reading of Windows settings-style surfaces
         So the user does not have to read a row first to know what the switch on the right controls
         The description follows under the title, read only when needed, and is otherwise just a faint second line

         The content **fills the available width**, as on this project's other pages (log page, mappings page)
         The margins come from this layer's Padding alone, with no maximum width and no centring
         The width is decided entirely by the window, so the cards follow when the window is dragged
         No size is hardcoded anywhere
         Controls inside a card carry no width either
         The exception is the proxy input box: an address is far longer than a button, see the note there
 -->
    <Grid Padding="24,18,24,20">
        <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <!-- 这一层只负责纵向间距：宽度从 ScrollViewer 一路传下来，卡片自己撑满
                 This layer only sets vertical spacing
                 The width comes down from the ScrollViewer and each card fills it -->
            <StackPanel Spacing="10">

                <TextBlock x:Name="PageTitle" Style="{ThemeResource MiditapTitleStyle}" Margin="0,0,0,6" />

                <!-- ===== 语言 / Language =====
                     置顶：它是用户最可能需要先改的一项 —— 看不懂界面时第一件事就是换语言
                     Topmost: the item a user is most likely to need first
                     When the interface is unreadable, switching the language comes first -->
                <controls:SettingsCard x:Name="LanguageCard" Glyph="&#xE8C1;">
                    <controls:SettingsCard.Action>
                        <!-- 不写宽度：下拉框按自身内容取宽（卡片右列已经是 Auto 列）
                             语言项又是运行期从 i18n 目录读出来的，写死一个数字只会是多余的约束
                             No width: the drop-down sizes to its own content (the card's right column is already Auto)
                             Its items are read from the i18n folder at run time
                             A hardcoded number would be a constraint with nothing behind it -->
                        <ComboBox x:Name="LanguageBox" SelectionChanged="OnLanguageSelected" />
                    </controls:SettingsCard.Action>
                </controls:SettingsCard>

                <!-- ===== 外观 / Appearance =====
                     用下拉框而不是一排单选按钮
                     A drop-down rather than a row of radio buttons -->
                <controls:SettingsCard x:Name="ThemeCard" Glyph="&#xE790;">
                    <controls:SettingsCard.Action>
                        <!-- 条目**不在 XAML 里写死**：由代码按 Core 的 SupportedThemes 生成
                             文案键按约定拼出（settings.theme.<模式>）
                             The items are **not hardcoded in XAML**
                             The code generates them from Core's SupportedThemes, and the label keys are composed by convention (settings.theme.<mode>) -->
                        <ComboBox x:Name="ThemeBox" SelectionChanged="OnThemeChanged" />
                    </controls:SettingsCard.Action>
                </controls:SettingsCard>

                <!-- ===== 配置目录 / Config folder =====
                     放在活动日志上方：两者都是打开一个目录，相邻便于对照
                     只有按钮没有开关，因为这里没有可切换的状态
                     Sits above the activity log: both open a folder, so keeping the pair adjacent reads better
                     A button and no switch, because nothing here has a state to toggle -->
                <controls:SettingsCard x:Name="ConfigCard" Glyph="&#xE8B7;">
                    <controls:SettingsCard.Action>
                        <Button x:Name="OpenConfigDirBtn" Click="OnOpenConfigDir" />
                    </controls:SettingsCard.Action>
                </controls:SettingsCard>

                <!-- ===== 活动日志 / Activity log =====
                     开关不带可见标签：上面的标题与说明已经说清它管什么（原生设置的通行做法）
                     读屏用户拿到的名字由 AutomationProperties.Name 补上（见 RefreshTexts）
                     The switch carries no visible label
                     The title and description above already say what it controls, which is the native pattern
                     Screen readers get a name from AutomationProperties.Name (set in RefreshTexts) -->
                <controls:SettingsCard x:Name="LogCard" Glyph="&#xE7C3;">
                    <controls:SettingsCard.Action>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <!-- MinWidth=0：ToggleSwitch 的模板为 On/Off 内容预留宽度，即使两者都是空串
                                 布局宽度仍达 164px（可见仅 52px），会把按钮推远
                                 MinWidth=0: the template reserves room for On/Off content
                                 Even with both empty the layout width reaches 164px (only 52px visible)
                                 It pushes the buttons away -->
                            <ToggleSwitch x:Name="LogFileToggle" Toggled="OnLogFileToggled"
                                          OnContent="" OffContent="" MinWidth="0" />
                            <Button x:Name="OpenLogDirBtn" Click="OnOpenLogDir" />
                        </StackPanel>
                    </controls:SettingsCard.Action>
                </controls:SettingsCard>

                <!-- ===== 更新 / Updates ===== -->
                <controls:SettingsCard x:Name="UpdatesCard" Glyph="&#xE896;">
                    <controls:SettingsCard.Action>
                        <ToggleSwitch x:Name="AutoCheckToggle" Toggled="OnAutoCheckToggled"
                                      OnContent="" OffContent="" MinWidth="0" />
                    </controls:SettingsCard.Action>
                </controls:SettingsCard>


                <!-- ===== 代理 / Proxy ===== -->
                <controls:SettingsCard x:Name="ProxyCard" Glyph="&#xE774;">
                    <controls:SettingsCard.Action>
                        <!-- 地址比按钮长得多，给它可输入的宽度比"填满卡片"合理
                             An address is much longer than a button, and giving it room to be typed into beats filling the card -->
                        <TextBox x:Name="ProxyBox" TextChanged="OnProxyChanged" Width="240" />
                    </controls:SettingsCard.Action>
                </controls:SettingsCard>

                <!-- ===== MIDIBridge 扩展 / Remote playing (the MIDIBridge extension) =====
                     三行控件放在卡片的 Action 里纵向排：这是本页唯一需要多个输入框的卡片
                     行内用 Grid 两列（标签 + 输入框），而不是把说明堆在卡片左侧那一列
                     左侧那一列放这张卡自己的标题与说明，控件区放不下第二份

                     The controls are stacked vertically inside the card's Action
                     This is the only card on the page with more than one input
                     Each row is a two-column Grid (label + input) rather than more text in the card's left column,
                     which already carries this card's own title and description
                -->
                <StackPanel Spacing="10">
                    <!-- 状态卡与展开区要连成一整块：间距为 0、接缝处只留一条边框、圆角拼成上下两半
                         这三件事都由 SyncBridgeConfigPanel 按"是否展开"写入，收起时又各自是完整的圆角卡片

                         The status card and the expanded block have to read as a single block: no gap, a single
                         border line at the seam, and corner radii that halve across it
                         All three are written by SyncBridgeConfigPanel from the expanded state, so a collapsed block
                         leaves both as ordinary rounded cards -->
                    <StackPanel Spacing="0">
                        <!-- 状态卡：未安装与已安装都显示，说明行与右侧按钮由 SyncBridgeStatus 按状态填写
                             未安装时按钮禁用：没有已装的版本，"检查更新"没有比较对象
                             Status card: shown whether or not the extension is installed, with the description line
                             and the right-hand button filled by SyncBridgeStatus from the state
                             The button is disabled before installation, since "check for updates" has no installed
                             build to compare against -->
                        <controls:SettingsCard x:Name="BridgeStatusCard" Glyph="&#xE946;">
                            <controls:SettingsCard.Action>
                                <!-- 右侧放"安装"与展开箭头
                                     安装按钮留在这里而不是塞进展开区：未安装时展开区整体是收起的，
                                     把它放在里面等于把唯一的入口藏起来
                                     两者互斥显示：未安装时只有"安装"，装好后只剩箭头
                                     The right slot holds the install button and the disclosure chevron
                                     The install button stays here rather than inside the expanded block: with nothing
                                     installed that block is collapsed, so placing the button there would hide the only
                                     way in
                                     The two are mutually exclusive: before installation only "install" shows, and once
                                     the component is in place only the chevron does -->
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button x:Name="BridgeInstallBtn" Click="OnInstallBridgeClick"
                                            Style="{ThemeResource AccentButtonStyle}" Visibility="Collapsed" />
                                    <Button x:Name="BridgeConfigToggleBtn" Click="OnToggleBridgeConfig"
                                            Padding="8,4" Background="Transparent" BorderThickness="0">
                                        <FontIcon x:Name="BridgeConfigChevron" Glyph="&#xE70D;" FontSize="12"
                                                  Foreground="{ThemeResource MiditapTextSecondaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </controls:SettingsCard.Action>
                        </controls:SettingsCard>

                    <!-- 展开区：MIDIBridge 自己的设置挂在状态卡下面，默认收起
                         整块只有一层卡片外壳，里面是一排排的设置行（SettingsRow，不各自画边框）
                         这样点开看到的是一连排的设置，而不是几项各自一框
                         展开状态由 SyncBridgeConfigPanel 统一写入，箭头方向与这块的显隐不会各走各的

                         The expanded block: the extension's own settings hang under the status card, collapsed by
                         default
                         The block has one card shell only, holding rows of settings (SettingsRow, which draw no frame
                         of their own)
                         Expanding therefore reveals one strip of settings rather than one box per item
                         SyncBridgeConfigPanel writes the expanded state in one place, so the chevron direction and
                         this block's visibility cannot drift apart -->
                    <Border x:Name="BridgeConfigPanel" CornerRadius="0,0,8,8" Padding="16,12"
                            Background="{ThemeResource MiditapSurfaceBrush}"
                            BorderBrush="{ThemeResource MiditapSubtleBorderBrush}"
                            BorderThickness="1" Visibility="Collapsed">
                        <StackPanel Spacing="14">
                            <!-- 服务器列表：选择哪一台、当前这台叫什么、增删入口
                                 放在最上面：它是"连去哪"的决定者，下面的地址端口密码都是它的属性
                                 ComboBox 与名称框并排：先选后改名是最常见的两步，竖排会多一次视线跳跃

                                 The server list: which entry is in use, what it is called, and the add/remove entries
                                 It goes first because it decides where to connect, and the address, port and password
                                 below are all attributes of it
                                 The ComboBox and the name box sit side by side: pick, then rename, is the common order,
                                 and stacking them would add one more eye jump -->
                            <controls:SettingsRow x:Name="BridgeServerCard" Glyph="&#xE968;">
                                <controls:SettingsRow.Action>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox x:Name="BridgeServerBox" Width="150"
                                                  DisplayMemberPath="Label"
                                                  SelectionChanged="OnBridgeServerSelected" />
                                        <Button x:Name="BridgeServerAddBtn" Click="OnBridgeServerAdd" />
                                        <Button x:Name="BridgeServerRemoveBtn" Click="OnBridgeServerRemove" />
                                    </StackPanel>
                                </controls:SettingsRow.Action>
                            </controls:SettingsRow>

                            <controls:SettingsRow x:Name="BridgeServerNameCard" Glyph="&#xE8AC;">
                                <controls:SettingsRow.Action>
                                    <TextBox x:Name="BridgeServerNameBox" LostFocus="OnBridgeServerNameLostFocus"
                                             Width="240" />
                                </controls:SettingsRow.Action>
                            </controls:SettingsRow>

                            <controls:SettingsRow x:Name="BridgeHostCard" Glyph="&#xE774;">
                                <controls:SettingsRow.Action>
                                    <TextBox x:Name="BridgeHostBox" TextChanged="OnBridgeHostChanged" Width="240" />
                                </controls:SettingsRow.Action>
                            </controls:SettingsRow>

                            <controls:SettingsRow x:Name="BridgePortCard" Glyph="&#xE712;">
                                <controls:SettingsRow.Action>
                                    <TextBox x:Name="BridgePortBox" TextChanged="OnBridgePortChanged" Width="100" />
                                </controls:SettingsRow.Action>
                            </controls:SettingsRow>

                            <controls:SettingsRow x:Name="BridgePasswordCard" Glyph="&#xE192;">
                                <controls:SettingsRow.Action>
                                    <!-- 只在失焦时落盘：逐字符保存会给磁盘带来大量小写入，也会让 ACL 收紧反复执行
                                         Persisted on losing focus only: per-keystroke saves mean many tiny writes and repeated
                                         ACL narrowing -->
                                    <PasswordBox x:Name="BridgePasswordBox" PasswordChanged="OnBridgePasswordChanged"
                                                 LostFocus="OnBridgePasswordLostFocus" Width="240" />
                                </controls:SettingsRow.Action>
                            </controls:SettingsRow>

                            <controls:SettingsRow x:Name="BridgeStateCard" Glyph="&#xF0B9;">
                                <controls:SettingsRow.Action>
                                    <Button x:Name="BridgeReconnectBtn" Click="OnBridgeReconnect" />
                                </controls:SettingsRow.Action>
                            </controls:SettingsRow>

                            <controls:SettingsRow x:Name="BridgeUpdateRow" Glyph="&#xE895;">
                                <controls:SettingsRow.Action>
                                    <Button x:Name="BridgeCheckUpdateBtn" Click="OnCheckBridgeUpdate" />
                                </controls:SettingsRow.Action>
                            </controls:SettingsRow>

                            <!-- 可执行文件损坏时的重新安装入口：挂在「更新」这一行下面，与上面几项连成一片
                                 放在下拉区域内而不是外面另起一张卡：它说明的是"当前装的这个能不能用"，
                                 属于这条设置的一部分；另起一张卡会把它读成一条与设置无关的公告
                                 这一行平时收起，只有探测出损坏时才出现，且那时下拉区域会自动展开

                                 The reinstall entry for a damaged executable: it sits below the update row and stays
                                 part of the same block
                                 It belongs inside the drop-down rather than in a card of its own, because it reports
                                 whether the installed build works at all, which is part of these settings; a separate
                                 card would read as an announcement unrelated to them
                                 The row stays collapsed until a probe reports damage, and the drop-down expands by
                                 itself at that point -->
                            <controls:SettingsRow x:Name="BridgeDamagedRow" Glyph="&#xE7BA;" Visibility="Collapsed">
                                <controls:SettingsRow.Action>
                                    <Button x:Name="ReinstallDamagedBtn" Click="OnReinstallBridge"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                </controls:SettingsRow.Action>
                            </controls:SettingsRow>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- 协议不可用时的醒目提示：这是"装错了版本"而不是"没装"
                         所以紧跟那块连体卡片，并直接给出重新安装入口
                         它留在折叠块外面：折叠的是设置项，这条是需要当场看见的结论
                         与下面的 ACL 提示分开两张卡：一个是功能完全用不了，一个是密码保护不到位

                         The prominent notice for an unsupported protocol: this is "the wrong build is installed"
                         rather than "nothing is installed"
                         It therefore follows the joined card and carries the reinstall entry right here
                         It stays outside the collapsible block: what collapses is the settings, while this is a
                         conclusion the user has to see on arrival
                         It is a separate card from the ACL notice below: one means the feature does not work at
                         all, the other means the password is under-protected -->
                    <controls:SettingsCard x:Name="BridgeUnavailableCard" Glyph="&#xE7BA;">
                        <controls:SettingsCard.Action>
                            <Button x:Name="ReinstallBridgeBtn" Click="OnReinstallBridge"
                                    Style="{ThemeResource AccentButtonStyle}" />
                        </controls:SettingsCard.Action>
                    </controls:SettingsCard>

                    <!-- ACL 收紧失败时的常驻提示：FAT32/exFAT 的 U 盘与无 ACL 的共享盘都支持不了它
                         常驻而不是浮窗：密码已经在磁盘上以可被同机其它进程读取的形式存在了，
                         浮窗一过用户就再没有地方看到这个事实
                         它是可见文本而不是 Hint，因为 Hint 要求用户去悬浮才会看到，而这一条不该靠运气发现
                         与上面的设置块分开：这是"存得不够安全"的结论，与用户填了哪些值无关
                         A standing notice for a failed access narrowing: FAT32/exFAT USB sticks and shares
                         without ACL support cannot do it
                         Standing rather than a toast: the password is already on disk in a form other local
                         processes can read, and once a toast is gone there is nowhere left to see that fact
                         It is visible text rather than a Hint, because a Hint needs the user to hover, and this
                         is not something to stumble upon
                         It sits apart from the settings block above: this is a conclusion about how safely the
                         password is stored, not one of the values the user fills in -->
                    <controls:SettingsCard x:Name="BridgeAclCard" Glyph="&#xE72E;">
                        <controls:SettingsCard.Action>
                            <Button x:Name="BridgeRetryAclBtn" Click="OnRetryBridgeAcl" />
                        </controls:SettingsCard.Action>
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ===== 关于 / About ===== -->
                <controls:SettingsCard x:Name="AboutCard" Glyph="&#xE946;">
                    <controls:SettingsCard.Action>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="CheckUpdateBtn" Click="OnCheckUpdates"
                                    Style="{ThemeResource AccentButtonStyle}" />
                            <Button x:Name="GitHubBtn" Click="OnGitHub" />
                        </StackPanel>
                    </controls:SettingsCard.Action>
                </controls:SettingsCard>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
