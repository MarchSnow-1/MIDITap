<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MIDITap.App.Controls.SettingsRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">

    <!-- 一排的排布：Grid 三列，Auto 放图标、星号列放标题与说明、Auto 放右侧控件
         不画卡片：背景、边框与圆角由外层容器提供
         HorizontalContentAlignment/VerticalContentAlignment 须为 Stretch，否则星号列按不换行的说明文字撑开，
         右侧控件会被窗口裁掉

         One row's layout: a Grid of three columns, Auto for the icon, the star column for the title and description,
         Auto for the right-hand control
         No card is drawn here: the background, border and corner radius come from the enclosing container
         HorizontalContentAlignment/VerticalContentAlignment must be Stretch, or the star column expands to the width
         of an unwrapped description and pushes the right-hand control past the window edge -->
    <Grid ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <FontIcon x:Name="GlyphIcon" Grid.Column="0" FontSize="18" VerticalAlignment="Center"
                  Foreground="{ThemeResource MiditapTextSecondaryBrush}" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <TextBlock x:Name="HeaderText" Style="{ThemeResource MiditapSubtitleStyle}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="DescriptionText" Style="{ThemeResource MiditapCaptionStyle}"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <ContentPresenter x:Name="ActionHost" Grid.Column="2" VerticalAlignment="Center" />
    </Grid>
</UserControl>
