<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MIDITap.App.Dialogs.BridgeInstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{ThemeResource MiditapDialogStyle}">

    <!-- 按钮样式：对话框的按钮由 ContentDialog 依 PrimaryButtonStyle / CloseButtonStyle 生成
         不显式给这两项时，未打包（WindowsPackageType=None）的应用里它们落到直角
         因此这里各加一个圆角设置，配色、内边距与悬停态仍由主题负责

         Button styles: the dialog's buttons are generated by ContentDialog from PrimaryButtonStyle and
         CloseButtonStyle. Without those two set, they come out square in an unpackaged app
         (WindowsPackageType=None). Each style here therefore only adds a corner radius, leaving colours,
         padding and hover states to the theme -->
    <ContentDialog.Resources>
        <Style x:Key="BridgeDialogPrimaryStyle" TargetType="Button"
               BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="BridgeDialogCloseStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentDialog.Resources>

    <!-- 末段小字说明点下去等于同意什么，因此从正文退一档字号与颜色
         宽度上限挂在整个面板上，各段的换行宽度才一致

         The caption at the end states what clicking agrees to, so it steps down one size and one colour level
         The width cap sits on the panel, so every paragraph wraps at the same width -->
    <StackPanel MinWidth="380" MaxWidth="460" Spacing="10" Margin="0,8,0,0">
        <TextBlock x:Name="BodyText" Style="{ThemeResource MiditapBodyStyle}" TextWrapping="Wrap" />
        <TextBlock x:Name="SupportText" Style="{ThemeResource MiditapBodyStyle}" TextWrapping="Wrap" />
        <TextBlock x:Name="BenefitText" Style="{ThemeResource MiditapBodyStyle}" TextWrapping="Wrap" />
        <TextBlock x:Name="NoticeText" Style="{ThemeResource MiditapCaptionStyle}" TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
