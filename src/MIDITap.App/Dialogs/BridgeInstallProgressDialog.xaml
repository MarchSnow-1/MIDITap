<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MIDITap.App.Dialogs.BridgeInstallProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Closing="OnClosing"
    Style="{ThemeResource MiditapDialogStyle}">

    <ContentDialog.Resources>
        <!-- 关闭按钮的圆角：ContentDialog 自带的关闭按钮不吃主题里的圆角，因此单独给一个样式
             The close button's corner radius: ContentDialog's own close button does not pick up the theme's
             corner radius, so it gets a style of its own -->
        <Style x:Key="BridgeProgressCloseStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentDialog.Resources>

    <!-- 安装进度弹窗

         为什么不用浮窗逐条报进度：浮窗会排队堆叠，一次安装下来屏幕上摞着好几条，
         而安装本身只有"在下载"和"装完了"两个状态，正好是一个弹窗装得下的信息量

         为什么标题自己画：ContentDialog 的 Title 用的是另一套样式，自绘标题行才能与更新弹窗一致

         Install progress dialog

         Why not a toast per progress report: toasts queue up and a single install leaves several of them
         stacked on screen, while an install only ever has two states worth showing — downloading and done —
         which is exactly what one dialog holds

         Why the title is drawn here: ContentDialog's Title uses a different style, and drawing the row here
         is what keeps it the same as in the update dialog -->

    <Grid MinWidth="380" Margin="0,8,0,0">
        <StackPanel Spacing="14">
            <TextBlock x:Name="TitleText" Style="{ThemeResource MiditapSubtitleStyle}" TextWrapping="Wrap" />

            <!-- 状态行与进度条
                 状态行保留两行高度：失败文案比下载中的一行长，换行时进度条不该跟着跳一下
                 Status line and progress bar
                 The status line keeps room for two lines: a failure message is longer than the one-liner
                 shown while downloading, and the bar should not jump when it wraps -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="StatusText" Style="{ThemeResource MiditapBodyStyle}"
                           TextWrapping="Wrap" MinHeight="38" />
                <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ContentDialog>
