<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>MIDITap.App</RootNamespace>
    <!-- 产物命名 MIDITap.exe

         The output is named MIDITap.exe -->
    <AssemblyName>MIDITap</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 版本号与根目录 package.json 保持一致：npm version 改的是 package.json，这里不会自动跟着变
         发布时 release.yml 会用标签版本注入 -p:Version 覆盖它

         The version number is kept in step with the root package.json
         npm version edits package.json only, so this value does not follow automatically
         At release time release.yml overrides it by injecting -p:Version with the tag version -->
    <Version>2.0.0</Version>
    <!-- 版本号后面不追加 git 提交哈希
         SDK 默认会追加，把 InformationalVersion 变成 "1.7.1+<40位哈希>"
         而这一串会直接显示在「关于」区，既难看又不好抄
         开发构建需要可区分时，由 dev.yml 显式传入带标识的版本号（见那里的说明）
         Do not append the git commit hash to the version
         The SDK does by default, turning InformationalVersion into "1.7.1+<40-char hash>"
         That string then shows up verbatim under About — ugly and awkward to copy
         Development builds pass an identifying version explicitly from dev.yml instead -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\appIcon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <!-- 只引用 NAudio.Midi，而不是 NAudio 元包
         元包会把 NAudio.WinForms 一起拉进来，进而带上 System.Windows.Forms 与 PresentationFramework/PresentationCore（WPF）
         本应用是 WinUI 3，源码里只用到 NAudio.Midi，那些程序集纯属陪跑

         NAudio.Midi is referenced rather than the NAudio meta-package
         The meta-package also pulls in NAudio.WinForms
         That brings System.Windows.Forms and PresentationFramework/PresentationCore (WPF) with it
         This app is WinUI 3 and its source uses only NAudio.Midi
         Those assemblies are dead weight
 -->
    <PackageReference Include="NAudio.Midi" Version="2.4.0" />
    <!-- 更新弹窗里渲染发布说明（markdown）
         为什么用成熟库：markdown 的边界情况多（嵌套列表、转义、行内代码、链接），自行实现容易在细节上出错
         为什么是这个包：社区工具包里唯一的 WinUI 3 markdown 控件
         Markdig.Wpf 与 MdXaml 都基于 WPF，本应用是 WinUI 3，用不了
         它编入时针对 WindowsAppSDK 1.0.0，而本项目用 2.5.1，因此运行时兼容性需实机确认
         许可证 MIT

         Renders the release notes (markdown) inside the update dialog
         Why a mature library: markdown has many edge cases (nested lists, escapes, inline code, links)
         and a hand-written implementation tends to get the details wrong
         Why this package: it is the only WinUI 3 markdown control in the community toolkit
         Markdig.Wpf and MdXaml are WPF-based, and this app is WinUI 3
         It was compiled against WindowsAppSDK 1.0.0 while this project uses 2.5.1
         so runtime compatibility needs a real-machine check
         Licence: MIT -->
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.Markdown" Version="7.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MIDITap.Core\MIDITap.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\appIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\appIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="i18n\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>